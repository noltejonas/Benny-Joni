# Nach ios/App/fastlane/.env kopieren (gitignored) und ausfüllen.
# App-Store-Connect-API-Key: App Store Connect → Benutzer und Zugriff →
# Integrationen → App Store Connect API. Der Key braucht Zugriff auf
# Zertifikate und Profile, weil xcodebuild damit automatisch signiert.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Pfad zur .p8-Datei — absolut, mit ~ oder relativ zum Repo-Root
ASC_KEY_PATH=
