# Nach ios/App/fastlane/.env kopieren (gitignored) und ausfüllen.
# Das Repo ist öffentlich: echte Werte NUR in die .env, nie in diese Datei.
#
# App-Store-Connect-API-Key: App Store Connect → Benutzer und Zugriff →
# Integrationen → App Store Connect API. Der Key braucht Zugriff auf
# Zertifikate und Profile, weil xcodebuild damit automatisch signiert.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Pfad zur .p8-Datei — absolut, mit ~ oder relativ zum Repo-Root.
# Die .p8 liegt am besten außerhalb des Repos (z. B. ~/Keys/).
ASC_KEY_PATH=

# ── Nur für `fastlane release` (App-Store-Einreichung) ─────────────────────
# Kontakt und Login für die App-Prüfung. Fehlt einer dieser Werte, lädt
# release KEINE Review-Daten hoch; dann in App Store Connect von Hand eintragen.
REVIEW_FIRST_NAME=
REVIEW_LAST_NAME=
REVIEW_EMAIL=
# Mit Ländervorwahl, z. B. +49 …
REVIEW_PHONE=
# Login des Review-Kontos in der Produktions-App
REVIEW_USER=
REVIEW_PASSWORD=
# Einladungscode der Review-Challenge; ersetzt den Platzhalter in
# docs/launch/REVIEW_NOTES.md, damit der Code nicht im Repo steht.
REVIEW_CODE=

# ── Google Play (dieselbe Fastlane-Installation, Plattform android) ───────
# JSON-Schlüssel des Dienstkontos außerhalb des Repos speichern.
# Zugriff in Play Console auf genau diese App freigeben.
PLAY_JSON_KEY_PATH=
PLAY_PACKAGE_NAME=com.bennyjoni.terminator
