<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- Gemeinsamer Speicher mit dem Homescreen-Widget (Shared/WidgetStore.swift).
	     Die eigene Gruppe steht zuerst, damit sie Standard bleibt wie ohne Eintrag. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.bennyjoni.terminator</string>
		<string>$(AppIdentifierPrefix)com.bennyjoni.terminator.shared</string>
	</array>
</dict>
</plist>
